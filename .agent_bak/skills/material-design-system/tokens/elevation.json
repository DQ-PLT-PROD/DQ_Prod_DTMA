{
    "elevation": {
        "note": "Material Design 3 uses tonal elevation (surface tint + shadow)",
        "levels": {
            "0": {
                "shadow": "none",
                "surfaceTint": "0%",
                "usage": "Base surface, no elevation"
            },
            "1": {
                "shadow": "0 1px 2px 0 rgba(0, 0, 0, 0.05)",
                "surfaceTint": "5%",
                "tailwind": "shadow-sm",
                "usage": "Elevated cards, raised elements"
            },
            "2": {
                "shadow": "0 1px 3px 0 rgba(0, 0, 0, 0.1), 0 1px 2px -1px rgba(0, 0, 0, 0.1)",
                "surfaceTint": "8%",
                "tailwind": "shadow",
                "usage": "Floating elements, dropdowns"
            },
            "3": {
                "shadow": "0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -2px rgba(0, 0, 0, 0.1)",
                "surfaceTint": "11%",
                "tailwind": "shadow-md",
                "usage": "Modals, dialogs, menus"
            },
            "4": {
                "shadow": "0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -4px rgba(0, 0, 0, 0.1)",
                "surfaceTint": "12%",
                "tailwind": "shadow-lg",
                "usage": "Navigation drawer"
            },
            "5": {
                "shadow": "0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1)",
                "surfaceTint": "14%",
                "tailwind": "shadow-xl",
                "usage": "App bar, FAB"
            }
        },
        "implementation": {
            "note": "Combine shadow utility with surface tint background",
            "example": "<div className=\"shadow-md bg-surface-level-3\">Elevated content</div>"
        }
    }
}