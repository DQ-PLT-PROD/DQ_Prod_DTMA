# Azure MSAL Authentication Configuration - External ID (CIAM)
# Copy this file to .env and fill in your values

# Required: Azure AD External ID Client ID (Application ID)
VITE_AZURE_CLIENT_ID=your-client-id-here

# Required: Tenant ID (GUID for External ID)
VITE_AZURE_TENANT_ID=your-tenant-id-here

# Optional: Redirect URIs (defaults to current origin)
VITE_AZURE_REDIRECT_URI=http://localhost:3000
VITE_AZURE_POST_LOGOUT_REDIRECT_URI=http://localhost:3000

# Supabase Configuration (for CMS/Media Management only, not auth)
VITE_SUPABASE_URL=your-supabase-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
