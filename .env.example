# Azure MSAL Authentication Configuration - External ID (CIAM)
# Copy this file to .env and fill in your values

# Required: Azure AD External ID Client ID (Application ID)
VITE_AZURE_CLIENT_ID=your-client-id-here

# Required: Tenant ID (GUID - more reliable than tenant name for External ID)
VITE_AZURE_TENANT_ID=your-tenant-id-here

# Optional: Tenant Name (not needed when using Tenant ID)
# VITE_B2C_TENANT_NAME=your-tenant-name

# User Flow Name (Leave empty for External ID - it doesn't use user flows like B2C)
# VITE_B2C_POLICY_SIGNUP_SIGNIN=your-policy-name

# CIAM Subdomain (from Azure Portal endpoints)
VITE_AZURE_SUBDOMAIN=your-subdomain

# Optional: Redirect URIs (defaults to current origin)
VITE_AZURE_REDIRECT_URI=http://localhost:3000
VITE_AZURE_POST_LOGOUT_REDIRECT_URI=http://localhost:3000

# Optional: Enable Microsoft Graph fallback for email resolution
# VITE_MSAL_ENABLE_GRAPH_FALLBACK=true

# Supabase Configuration (for CMS/Media Management only, not auth)
VITE_SUPABASE_URL=your-supabase-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
