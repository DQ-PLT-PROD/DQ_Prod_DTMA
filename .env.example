# Azure AD External Identities (CIAM) Authentication
VITE_AZURE_CLIENT_ID=your_azure_client_id_here
VITE_AZURE_TENANT_ID=your_azure_tenant_id_here
VITE_AZURE_SUBDOMAIN=your_azure_subdomain_here

# Redirect URIs - Production URLs (localhost will be auto-detected for local dev)
VITE_AZURE_REDIRECT_URI=https://your-production-url.vercel.app/
VITE_AZURE_POST_LOGOUT_REDIRECT_URI=https://your-production-url.vercel.app/

# Supabase Configuration (for user data and business profiles)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Backend API Configuration
VITE_API_BASE_URL=http://localhost:4000/api

# Development/Testing Options
NODE_ENV=development
# VITE_USE_MOCK_AUTH=true
# VITE_BYPASS_AZURE_AUTH=true
