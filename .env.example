# Azure MSAL Authentication Configuration
# Copy this file to .env and fill in your values

# Required: Azure AD B2C/CIAM Client ID (Application ID)
VITE_AZURE_CLIENT_ID=your-client-id-here

# Required: Azure B2C Tenant Name (e.g., "yourcompany" for yourcompany.b2clogin.com)
VITE_B2C_TENANT_NAME=your-tenant-name

# Required: Azure B2C Sign-up/Sign-in Policy/User Flow Name
VITE_B2C_POLICY_SIGNUP_SIGNIN=your-policy-name

# Optional: Separate Sign-up Policy (if different from sign-in)
# VITE_B2C_POLICY_SIGNUP=your-signup-policy

# Optional: Custom Redirect URI (defaults to current origin)
# VITE_AZURE_REDIRECT_URI=http://localhost:3000

# Optional: Post-logout Redirect URI (defaults to redirect URI)
# VITE_AZURE_POST_LOGOUT_REDIRECT_URI=http://localhost:3000

# Optional: Azure CIAM Subdomain (for External ID/CIAM, not B2C)
# VITE_AZURE_SUBDOMAIN=your-subdomain

# Optional: Custom Identity Host (for CIAM)
# VITE_IDENTITY_HOST=yourtenant.ciamlogin.com

# Optional: API Scopes (space or comma separated)
# VITE_AZURE_SCOPES=api://your-api-id/scope1 api://your-api-id/scope2

# Optional: Enable Microsoft Graph fallback for email resolution
# VITE_MSAL_ENABLE_GRAPH_FALLBACK=true

# Supabase Configuration (for CMS/Media Management only, not auth)
VITE_SUPABASE_URL=your-supabase-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
