# Redirect URIs (optional - will auto-detect production URLs)
# Set these for production deployment or custom domains
VITE_AZURE_REDIRECT_URI=https://your-domain.com/
VITE_AZURE_POST_LOGOUT_REDIRECT_URI=https://your-domain.com/

# Supabase Configuration (for user data and business profiles)
