# Azure AD External Identities (CIAM) Authentication
VITE_AZURE_CLIENT_ID=your-client-id-here
VITE_AZURE_TENANT_ID=your-tenant-id-here
VITE_AZURE_CIAM_DOMAIN=your-domain.ciamlogin.com

# Redirect URIs (optional - will auto-detect production URLs)
# Only needed for localhost development
VITE_AZURE_REDIRECT_URI=http://localhost:3000
VITE_AZURE_POST_LOGOUT_REDIRECT_URI=http://localhost:3000

# Supabase Configuration (for user data and business profiles)
VITE_SUPABASE_URL=your-supabase-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Development/Testing Options (optional)
# VITE_USE_MOCK_AUTH=true
# VITE_BYPASS_AZURE_AUTH=true
